<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_tck_form" model="ir.ui.view">
        <field name="name">company_hr_military.tck.form</field>
        <field name="model">company_hr_military.tck</field>
        <field name="arch" type="xml">
            <form string="ТЦК та СП">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_tck_list" model="ir.ui.view">
        <field name="name">company_hr_military.tck.list</field>
        <field name="model">company_hr_military.tck</field>
        <field name="arch" type="xml">
            <list string="ТЦК та СП">
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tck" model="ir.actions.act_window">
        <field name="name">ТЦК та СП</field>
        <field name="res_model">company_hr_military.tck</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item (Співробітники -> Налаштування) -->
    <!-- Assuming hr.menu_human_resources_configuration is the parent -->
    <menuitem id="menu_tck"
              name="ТЦК та СП"
              parent="hr.menu_human_resources_configuration"
              action="action_tck"
              sequence="100"/>

</odoo>
